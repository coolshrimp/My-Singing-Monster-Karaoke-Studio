<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**\*;dist\**\*;publish-win-x64\**\*</DefaultItemExcludes>
    <AssemblyName>MySingingMonsterKaraokeStudio</AssemblyName>
    <RootNamespace>MySingingMonsterKaraokeStudio</RootNamespace>
    <Version>0.10.14</Version>
    <Authors>Coolshrimp</Authors>
    <Product>My Singing Monster Karaoke Studio</Product>
    <RepositoryUrl>https://github.com/coolshrimp/My-Singing-Monster-Karaoke-Studio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>Assets\StudioIcon.ico</ApplicationIcon>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true' and '$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' != 'true' or '$(PublishSingleFile)' != 'true'">false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\StudioIcon.ico" />
    <Resource Include="Assets\StudioIcon.png" />
    <EmbeddedResource Include="WebEditor\**\*" />
    <EmbeddedResource Include="Tools\FFmpeg-*.txt" LogicalName="MySingingMonsterKaraokeStudio.Tools.%(Filename)%(Extension)" />
    <Content Include="scripts\install-ffmpeg.cmd" Link="install-ffmpeg.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
