<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySingingMonsterKaraokeStudio"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        x:Class="MySingingMonsterKaraokeStudio.MainWindow"
        Title="My Singing Monster Karaoke Studio"
        Icon="Assets/StudioIcon.ico"
        Width="1450"
        Height="950"
        MinWidth="1100"
        MinHeight="720"
        Background="#10151E"
        Foreground="#EEF3FC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEF3FC"/>
            <Setter Property="Background" Value="#253147"/>
            <Setter Property="BorderBrush" Value="#3A4861"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#364867"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A2BAFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EEF3FC"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="MenuHeader" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <TextBlock x:Name="MenuGesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="#97A9C4" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MenuArrow" Grid.Column="2" Text="›" Margin="12,0,0,0"/>
                                <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="#202A3B" BorderBrush="#44536B" BorderThickness="1" CornerRadius="6" Padding="5" MinWidth="230">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="MenuArrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter Property="Padding" Value="12,7"/>
                                <Setter TargetName="MenuHeader" Property="Margin" Value="0"/>
                                <Setter TargetName="MenuHeader" Property="Grid.ColumnSpan" Value="3"/>
                                <Setter TargetName="MenuHeader" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="MenuGesture" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                <Setter TargetName="MenuArrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter Property="Padding" Value="12,7"/>
                                <Setter TargetName="MenuHeader" Property="Margin" Value="0"/>
                                <Setter TargetName="MenuHeader" Property="Grid.ColumnSpan" Value="3"/>
                                <Setter TargetName="MenuHeader" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="MenuGesture" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="MenuArrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#354663"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuBorder" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#39465B"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RecentBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RecentBorder" Property="Background" Value="#2D4163"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RecentBorder" Property="Background" Value="#26364E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8FA1BB"/>
            <Setter Property="Margin" Value="3,14,0,8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Background="#192231">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,16,0" FontSize="11">
                <Hyperlink xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="CreatorLink" NavigateUri="https://coolshrimpmodz.com/" RequestNavigate="CreatorLink_RequestNavigate" Foreground="#AFCBFF" ToolTip="Open coolshrimpmodz.com in your browser">Created by Coolshrimp</Hyperlink>
            </TextBlock>
            <Menu x:Name="StudioMenu" Background="#192231" Foreground="#EEF3FC" Padding="8,0">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Song…" Command="{x:Static local:StudioCommands.New}" InputGestureText="Ctrl+N"/>
                    <MenuItem Header="_Open Song / Project…" Command="{x:Static local:StudioCommands.Open}" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Open Project _Folder…" Command="{x:Static local:StudioCommands.OpenFolder}"/>
                    <MenuItem Header="Open Studio _Chart…" Command="{x:Static local:StudioCommands.OpenChart}"/>
                    <MenuItem Header="_Import MP3 / Audio…" Command="{x:Static local:StudioCommands.Import}"/>
                    <Separator/>
                    <MenuItem Header="Save _Project" Command="{x:Static local:StudioCommands.SaveProject}" InputGestureText="Ctrl+Alt+S"/>
                    <MenuItem Header="Save Project _As…" Command="{x:Static local:StudioCommands.SaveProjectAs}" InputGestureText="Ctrl+Shift+S"/>
                    <MenuItem Header="Save Chart As…" Command="{x:Static local:StudioCommands.SaveChart}" InputGestureText="Ctrl+S"/>
                    <MenuItem Header="Save .mid / .tmb…" Command="{x:Static local:StudioCommands.SaveMidiTmb}"/>
                    <MenuItem Header="Save OGG As…" Command="{x:Static local:StudioCommands.SaveOggAs}"/>
                    <MenuItem Header="_Export ZIP…" Command="{x:Static local:StudioCommands.Export}"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Command="{x:Static local:StudioCommands.Exit}"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Chart Info…" Command="{x:Static local:StudioCommands.ChartInfo}"/>
                    <MenuItem Header="_Undo" Command="{x:Static local:StudioCommands.Undo}" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="_Redo" Command="{x:Static local:StudioCommands.Redo}" InputGestureText="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Select _All Notes" Command="{x:Static local:StudioCommands.SelectAll}" InputGestureText="Ctrl+A"/>
                    <MenuItem Header="_Clear Selection" Command="{x:Static local:StudioCommands.ClearSelection}" InputGestureText="Esc"/>
                    <MenuItem Header="_Delete Selected Notes" Command="{x:Static local:StudioCommands.Delete}" InputGestureText="Delete"/>
                </MenuItem>
                <MenuItem Header="_Playback">
                    <MenuItem Header="_Play / Pause" Command="{x:Static local:StudioCommands.Play}"/>
                    <MenuItem Header="_Stop" Command="{x:Static local:StudioCommands.Stop}"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Online Library / Downloads…" Command="{x:Static local:StudioCommands.Library}"/>
                    <MenuItem Header="Open Project Folder" Command="{x:Static local:StudioCommands.ProjectFolder}"/>
                    <MenuItem Header="Open Working Folder" Command="{x:Static local:StudioCommands.WorkingFolder}"/>
                    <MenuItem Header="Open Studio Folder" Command="{x:Static local:StudioCommands.StudioFolder}"/>
                    <Separator/>
                    <MenuItem Header="Choose Working Folder…" Command="{x:Static local:StudioCommands.ChangeWorkingFolder}"/>
                </MenuItem>
                <MenuItem Header="_Game">
                    <MenuItem Header="Import / Update Current Level in Game" Command="{x:Static local:StudioCommands.ImportGame}"/>
                    <MenuItem Header="Remove Current Level from Game…" Command="{x:Static local:StudioCommands.RemoveGame}"/>
                    <Separator/>
                    <MenuItem Header="Manage Game Songs…" Command="{x:Static local:StudioCommands.GameSongs}"/>
                    <MenuItem Header="Open Game Songs Folder" Command="{x:Static local:StudioCommands.GameFolder}"/>
                    <MenuItem Header="Refresh Game Status" Command="{x:Static local:StudioCommands.RefreshGame}"/>
                    <MenuItem Header="Choose Game Data Folder…" Command="{x:Static local:StudioCommands.ChangeGameFolder}"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="Convert Audio to OGG" Command="{x:Static local:StudioCommands.Convert}"/>
                    <MenuItem Header="Auto Chart" Command="{x:Static local:StudioCommands.Generate}"/>
                    <MenuItem Header="Trim Audio to Selected Range" Command="{x:Static local:StudioCommands.Trim}"/>
                    <Separator/>
                    <MenuItem Header="Set Up / Check FFmpeg" Command="{x:Static local:StudioCommands.Setup}"/>
                </MenuItem>
            </Menu>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="254"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#181F2C" BorderBrush="#303C51" BorderThickness="0,0,1,0">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="My Singing Monster Karaoke Studio" TextWrapping="Wrap" FontSize="20" FontWeight="Bold" Margin="2,4,0,0"/>
                        <TextBlock Text="SONG WORKSPACE" FontSize="10" Foreground="#9EB3D5" Margin="3,3,0,18"/>
                        <Button x:Name="NewProjectButton" Content="+ New Song…" Command="{x:Static local:StudioCommands.New}" Background="#4668AD" BorderBrush="#6E92D8" Height="40" Margin="0,0,0,7"/>
                        <Button x:Name="OpenProjectButton" Content="Open Song / Project…" Command="{x:Static local:StudioCommands.Open}" Height="36"/>
                        <Button x:Name="ImportMp3Button" Content="Import MP3 / Audio…" Command="{x:Static local:StudioCommands.Import}" Height="36" Margin="0,7,0,0" Background="#314F83" ToolTip="Choose audio to create a song with automatic charts for all difficulties"/>
                        <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button x:Name="RevealProjectFolderButton" Content="Project Folder" Command="{x:Static local:StudioCommands.ProjectFolder}" Padding="5,8" Margin="0,0,4,0" ToolTip="Open this song's audio and chart files in Explorer"/>
                            <Button Content="Working Folder" Command="{x:Static local:StudioCommands.WorkingFolder}" Padding="5,8" Margin="4,0,0,0" ToolTip="Open the song library in Explorer"/>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Button Content="Studio Folder" Command="{x:Static local:StudioCommands.StudioFolder}" Padding="5,8" Margin="0,0,4,0" ToolTip="Open the application's folder"/>
                            <Button Content="Change…" Command="{x:Static local:StudioCommands.ChangeWorkingFolder}" Padding="5,8" Margin="4,0,0,0" ToolTip="Choose where to keep new songs"/>
                        </UniformGrid>
                        <TextBlock x:Name="WorkingFolderText" FontSize="10" Foreground="#8FA1BB" TextWrapping="Wrap" MaxHeight="44" Margin="3,8,3,0"/>
                        <TextBlock Text="RECENT PROJECTS" Style="{StaticResource SectionLabel}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <TextBlock Text="AUDIO CONVERTER" Style="{StaticResource SectionLabel}" Margin="3,0,0,8"/>
                        <Button x:Name="InstallFfmpegButton" Content="Install FFmpeg" Command="{x:Static local:StudioCommands.Setup}" Height="34"/>
                        <TextBlock x:Name="FfmpegSetupStatus" Text="Audio converter: setup available" FontSize="11" Foreground="#A2B4CF" TextWrapping="Wrap" Margin="3,7,3,7"/>
                        <ProgressBar x:Name="FfmpegInstallProgress" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="3,0,3,10"/>
                        <TextBlock Text="My Singing Monster Karaoke Studio 0.10.14" TextWrapping="Wrap" FontSize="10" Foreground="#6F819C" Margin="3,8,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="RecentProjectsList" Background="Transparent" BorderThickness="0" Foreground="#EEF3FC" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="RecentProjectsList_SelectionChanged" PreviewMouseRightButtonDown="RecentProjectsList_PreviewMouseRightButtonDown" ContextMenuOpening="RecentProjectsList_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="RecentProjectsContextMenu" Background="#202A3B" Foreground="#EEF3FC" BorderBrush="#44536B" BorderThickness="1" Padding="5">
                                <MenuItem Header="Open Project" Tag="Open" Click="RecentProjectMenu_Click"/>
                                <MenuItem Header="Rename Song…" Tag="Rename" Click="RecentProjectMenu_Click"/>
                                <MenuItem Header="Chart Info…" Tag="ChartInfo" Click="RecentProjectMenu_Click"/>
                                <MenuItem Header="Save Project" Tag="Save" Click="RecentProjectMenu_Click"/>
                                <MenuItem Header="Open Project Folder" Tag="Folder" Click="RecentProjectMenu_Click"/>
                                <Separator/>
                                <MenuItem Header="Import / Update in Game" Tag="ImportGame" Click="RecentProjectMenu_Click"/>
                                <MenuItem Header="Remove from Game…" Tag="RemoveGame" Click="RecentProjectMenu_Click"/>
                                <Separator/>
                                <MenuItem Header="Remove from Recent Projects" Tag="Remove" Click="RecentProjectMenu_Click" ToolTip="Hide this entry; its project and audio files are kept"/>
                                <MenuItem Header="Refresh List" Tag="Refresh" Click="RecentProjectMenu_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding FilePath}">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="#9EB0CB" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding GameStatus}" FontSize="10" Foreground="{Binding GameStatusColor}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding GameStatus}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>
                <Border Background="#192230" BorderBrush="#303C51" BorderThickness="0,0,0,1">
                    <Grid Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="ProjectTitle" Text="Open an MP3 to start your song" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ProjectPathText" Text="Import audio → trim → generate notes → edit → export" FontSize="11" Foreground="#9EB0CB" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock x:Name="ProjectInfoText" Text="Audio • Chart • Package" FontSize="11" Foreground="#A8BCD9"/>
                                <TextBlock x:Name="ProjectStateText" Text="" FontSize="11" Foreground="#AAC4FF" Margin="14,0,0,0"/>
                                <TextBlock x:Name="GameStatusText" Text="" FontSize="11" Foreground="#B5CEFF" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ChartInfoButton" Content="Chart Info…" Command="{x:Static local:StudioCommands.ChartInfo}" Margin="0,0,8,0" ToolTip="Edit this song's title, artist and chart details"/>
                            <Button Content="Save Project" Command="{x:Static local:StudioCommands.SaveProject}" Margin="0,0,8,0" ToolTip="Save the working project"/>
                            <Button Content="Save Project As…" Command="{x:Static local:StudioCommands.SaveProjectAs}" ToolTip="Save a separate project with its audio files"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <WrapPanel x:Name="AudioActions" Grid.Row="1" Background="#141C28" Margin="0" Orientation="Horizontal">
                    <Button Content="Import an MP3" Command="{x:Static local:StudioCommands.Import}" Margin="12,9,6,9"/>
                    <Button Content="Open Chart" Command="{x:Static local:StudioCommands.OpenChart}" Margin="0,9,6,9"/>
                    <Button x:Name="SaveChartAsButton" Content="Save Chart As…" Command="{x:Static local:StudioCommands.SaveChart}" Margin="0,9,6,9" Background="#314E85"/>
                    <Button Content="Convert to OGG" Command="{x:Static local:StudioCommands.Convert}" Margin="0,9,6,9"/>
                    <Button x:Name="SaveOggAsButton" Content="Save OGG As…" Command="{x:Static local:StudioCommands.SaveOggAs}" Margin="0,9,6,9" ToolTip="Choose a filename and folder for the converted audio" Background="#314E85"/>
                    <Button x:Name="SaveMidiTmbButton" Content="Save .mid / .tmb" Command="{x:Static local:StudioCommands.SaveMidiTmb}" Margin="0,9,6,9"/>
                    <Button Content="Export ZIP…" Command="{x:Static local:StudioCommands.Export}" Margin="0,9,6,9"/>
                    <Button x:Name="ImportGameButton" Content="Import into Game" Command="{x:Static local:StudioCommands.ImportGame}" Margin="0,9,12,9" Background="#355F48" ToolTip="Build the current level and add its audio and chart directly to the game's Songs folder"/>
                    <Button x:Name="ManageGameSongsButton" Content="Manage Game Songs…" Command="{x:Static local:StudioCommands.GameSongs}" Margin="0,9,6,9" ToolTip="View installed songs and remove them into a recoverable backup" Click="ManageGameSongsButton_Click"/>
                    <Button Content="Library…" Command="{x:Static local:StudioCommands.Library}" Margin="0,9,6,9"/>
                </WrapPanel>
                <WrapPanel Grid.Row="2" Background="#192230" Margin="0" VerticalAlignment="Center">
                    <TextBlock Text="Level" VerticalAlignment="Center" Margin="14,7,7,7"/>
                    <ComboBox x:Name="DifficultyPicker" Width="110" SelectedIndex="1" IsEnabled="False" SelectionChanged="DifficultyPicker_SelectionChanged" Margin="0,6,6,6" Foreground="#172237">
                        <ComboBoxItem Content="Easy"/>
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="Hard"/>
                        <ComboBoxItem Content="Expert"/>
                    </ComboBox>
                    <Button x:Name="RefreshChartButton" Content="↻ Auto Chart" Command="{x:Static local:StudioCommands.Generate}" Padding="10,5" Margin="0,6,16,6" ToolTip="Regenerate this difficulty's notes from the current song audio; other levels are kept"/>
                    <TextBlock Text="Trim from" VerticalAlignment="Center" Margin="0,7,7,7"/>
                    <TextBox x:Name="TrimStartText" Text="0" Width="65" Padding="7,4" Margin="0,6,7,6" Background="#253147" Foreground="#EEF3FC" BorderBrush="#3A4861" ToolTip="Start time in seconds"/>
                    <TextBlock Text="to" VerticalAlignment="Center" Margin="0,7,7,7"/>
                    <TextBox x:Name="TrimEndText" Text="0" Width="65" Padding="7,4" Margin="0,6,7,6" Background="#253147" Foreground="#EEF3FC" BorderBrush="#3A4861" ToolTip="End time in seconds"/>
                    <TextBlock Text="seconds" VerticalAlignment="Center" Margin="0,7,10,7"/>
                    <Button Content="Trim Audio" Command="{x:Static local:StudioCommands.Trim}" Padding="10,5" Margin="0,6,14,6" ToolTip="Drag waveform handles or enter times, then clip to a new OGG. Original imported audio is never changed."/>
                    <TextBlock x:Name="FormatHint" Text="MSM Karaoke · TMB + OGG · Review automatic notes before playing" FontSize="10" Foreground="#9EB0CB" VerticalAlignment="Center" Margin="0,7,12,7"/>
                </WrapPanel>
                <wv2:WebView2 x:Name="EditorWebView" Grid.Row="3" DefaultBackgroundColor="#101218"/>
                <Border Grid.Row="4" Background="#192230" BorderBrush="#303C51" BorderThickness="0,1,0,0">
                    <Grid Margin="14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="OperationProgress" IsIndeterminate="True" Width="34" Height="5" Visibility="Collapsed" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" Foreground="#B2C4DE" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <StackPanel x:Name="FooterActions" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="Project Folder" Command="{x:Static local:StudioCommands.ProjectFolder}" Padding="10,6" Margin="0,0,6,0"/>
                            <Button Content="Working Folder" Command="{x:Static local:StudioCommands.WorkingFolder}" Padding="10,6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
